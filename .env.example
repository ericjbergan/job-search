# Copy to `.env` and fill in your key. `.env` is gitignored.

# OpenWeb Ninja JSearch API key (https://www.openwebninja.com/api/jsearch)
JSEARCH_API_KEY=

# OpenAI key for the "Look up benefits" button (optional; the button is disabled without it)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: port for the web UI (default 5001; the book catalog uses 5000)
# JOBSEARCH_PORT=5001

# Optional: where the Back up button saves copies (default: "Job Search backups" in OneDrive)
# BACKUP_DIR=
